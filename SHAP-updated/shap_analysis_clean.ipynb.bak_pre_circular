    "\n",
    "def anatomical_bound(name):\n",
    "    n = name.lower()\n",
    "    for keys, (lo, hi) in ANATOMICAL_BOUNDS.items():\n",
    "        if all(k in n for k in keys):\n",
    "            return lo, hi\n",
    "    return float('-inf'), float('inf')\n",
    "\n",
    "def coachability(name):\n",
    "    n = name.lower()\n",
